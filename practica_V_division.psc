Algoritmo practica_V_division
	Definir dividendo Como Real;
	Definir divisor Como Real;
	Definir resto Como Real;
	
	Escribir "Ingrese dividendo:";
	Leer dividendo;
	Escribir "Ingrese divisor:";
	Leer divisor;
	
	resto<- dividendo MOD divisor;
	
	Escribir "Dividendo:", dividendo;
	Escribir "Divisor:", divisor;
	Escribir "Resto:", resto;
FinAlgoritmo
