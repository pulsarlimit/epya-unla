Algoritmo practica_I_operaciones_basicas
	Definir a Como Real;
	Definir b Como Real;
	
	Escribir "Ingrese a:";
	Leer a;
	Escribir "Ingrese b:";
	Leer b;
	
	Escribir a, "+", b, "=", a+b;
	Escribir a, "-", b, "=", a-b;
	Escribir a, "*", b, "=", a*b;
	Escribir a, "/", b, "=", a/b;
FinAlgoritmo